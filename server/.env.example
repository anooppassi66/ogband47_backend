# Copy to server/.env. Any variable left unset here falls back to the Next.js
# app's ../.env.local, so for local development you can usually leave this
# file empty. In production, set these as real environment variables.

PORT=4000

# Set to "production" when deployed. In any other mode, password-reset codes
# are printed to the console when SMTP isn't configured, to make testing easier.
# NODE_ENV=production

# Same PostgreSQL database the website uses.
DATABASE_URL=

# Comma-separated list of allowed browser origins (e.g. Expo web on
# http://localhost:8081). Leave unset to allow any origin — native mobile apps
# don't send an Origin header, so CORS only matters for browser clients.
CORS_ORIGIN=

# Base URL of the website, used for links inside notification emails.
SITE_URL=http://localhost:3000

# SMTP for order / new-arrival emails. Emails are skipped if SMTP_PASS is unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Virtual try-on provider.
FITROOM_API_KEY=
